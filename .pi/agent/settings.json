{
  "lastChangelogVersion": "1.5.0",
  "theme": "nord",
  "npmCommand": [
    "bun"
  ],
  "packages": [
    "git:github.com/obra/superpowers",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "git:github.com/shadcn/improve",
    "npm:pi-memory",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-background-tasks@latest",
    "npm:@narumitw/pi-plan-mode",
    "npm:openwiki",
    "npm:pi-btw"
  ],
  "subagents": {
    "defaultModel": "deepseek-v4.1-flash:1017-cloud",
    "defaultThinking": "high",
    "maxThinking": "high",
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "ollama/*flash*cloud"
      ],
      "agents": {
        "reviewer": {
          "allow": [
            "ollama/deepseek-v4.1-flash:1017-cloud"
          ]
        },
        "engineering-code-reviewer": {
          "allow": [
            "ollama/deepseek-v4.1-flash:1017-cloud"
          ]
        },
        "oracle": {
          "allow": [
            "ollama/deepseek-v4.1-flash:1017-cloud"
          ]
        }
      }
    },
    "agentOverrides": {
      "scout": {
        "thinking": "high",
        "inheritSkills": true,
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "mcp",
          "contact_supervisor"
        ]
      },
      "worker": {
        "inheritSkills": true,
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "mcp",
          "contact_supervisor"
        ]
      },
      "reviewer": {
        "model": "deepseek-v4.1-flash:1017-cloud",
        "inheritSkills": true,
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "mcp",
          "contact_supervisor"
        ]
      },
      "engineering-code-reviewer": {
        "model": "deepseek-v4.1-flash:1017-cloud",
        "thinking": "high",
        "inheritSkills": true,
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "mcp"
        ]
      },
      "testing-accessibility-auditor": {
        "inheritSkills": true,
        "tools": [
          "read",
          "write",
          "edit",
          "bash",
          "grep",
          "find",
          "ls",
          "mcp"
        ]
      }
    }
  },
  "hideThinkingBlock": false,
  "extensions": [
    "-builtin:mcp"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.84.0",
