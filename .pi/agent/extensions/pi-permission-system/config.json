{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env*": "deny",
      "*/.env*": "deny",
      "*.env.example": "allow",
      "*.envrc": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa*": "deny",
      "id_ed25519*": "deny",
      "id_ecdsa*": "deny",
      ".ssh/**": "deny",
      "~/.ssh/**": "deny",
      ".aws/**": "deny",
      "~/.aws/**": "deny",
      ".gnupg/**": "deny",
      "~/.gnupg/**": "deny",
      "*.npmrc": "deny",
      "*.netrc": "deny",
      "*.pgpass": "deny",
      ".docker/config.json": "deny",
      "*/.docker/config.json": "deny",
      "~/.config/fish/fish_variables": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.jks": "deny",
      "*.keystore": "deny",
      "*.ovpn": "deny",
      "*.kdbx": "deny",
      ".git-credentials": "deny",
      "*/.git-credentials": "deny",
      "~/.config/gh/**": "deny",
      "~/.kube/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.password-store/**": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf /": "deny",
      "rm -rf ~": "deny",
      "rm -rf /*": "deny",
      "sudo *": "deny",
      "sudo": "deny",
      "ssh *": "deny",
      "ssh": "deny",
      "scp *": "deny",
      "scp": "deny",
      "sftp *": "deny",
      "sftp": "deny",
      "rsync *": "deny",
      "git push --force*": "deny",
      "node -e *": "deny",
      "node --eval *": "deny",
      "bun -e *": "deny",
      "python -c *": "deny",
      "python3 -c *": "deny",
      "php -r *": "deny",
      "perl -e *": "deny",
      "ruby -e *": "deny",
      "deno eval *": "deny",
      "eval *": "deny"
    },
    "external_directory": "allow"
  }
}
