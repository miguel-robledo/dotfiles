{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*.pem": "deny",
      "id_rsa*": "deny",
      ".ssh/**": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf /": "deny",
      "rm -rf ~": "deny",
      "rm -rf /*": "deny",
      "sudo *": "deny",
      "sudo": "deny",
      "ssh *": "deny",
      "ssh": "deny",
      "scp *": "deny",
      "scp": "deny",
      "sftp *": "deny",
      "sftp": "deny",
      "rsync *": "deny",
      "git push --force*": "deny"
    },
    "external_directory": "allow"
  }
}