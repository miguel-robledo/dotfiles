{
  "servers": {
    "typescript-language-server": {
      "command": "typescript-language-server",
      "args": ["--stdio"],
      "fileTypes": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"],
      "rootMarkers": [".git", "tsconfig.json", "package.json", "jsconfig.json"]
    },
    "intelephense": {
      "command": "intelephense-lsp",
      "args": ["--stdio"],
      "fileTypes": [".php"],
      "rootMarkers": [".git", "composer.json", "config.php", "version.php"],
      "initOptions": {
        "storagePath": "/home/miguel/.cache/intelephense",
        "clearCache": false
      },
      "settings": {
        "intelephense": {
          "files": {
            "maxSize": 5000000,
            "associations": ["**/*.php", "**/*.inc"]
          },
          "environment": {
            "phpVersion": "8.3.0",
            "includePaths": []
          },
          "format": { "enable": false },
          "completion": { "triggerParameterHints": true }
        }
      }
    }
  },
  "idleTimeoutMs": 300000
}
